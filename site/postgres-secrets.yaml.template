# -----------------------------------------------------------
# Database connection secrets for AAP components.
#
# BEFORE APPLYING:
#
# 1. Update CHANGEME_NAMESPACE to match your NAMESPACE from site-config.yaml
# 2. Update CHANGEME_PG_CLUSTER to match your PG_CLUSTER_NAME from site-config.yaml
# 3. Get the Postgres password:
#      oc get secret <PG_CLUSTER_NAME>-superuser -n <NAMESPACE> \
#        -o jsonpath='{.data.password}' | base64 -d
# 4. Replace CHANGEME_PASSWORD with the actual password
# 5. Apply:
#      oc apply -f postgres-secrets.yaml
# -----------------------------------------------------------
apiVersion: v1
kind: Secret
metadata:
  name: gateway-postgres-configuration
  namespace: CHANGEME_NAMESPACE
type: Opaque
stringData:
  host: CHANGEME_PG_CLUSTER-rw.CHANGEME_NAMESPACE.svc
  port: "5432"
  database: aap_gateway
  username: app
  password: CHANGEME_PASSWORD
  sslmode: prefer
  type: unmanaged
---
