# -----------------------------------------------------------
# These secrets tell each AAP component how to connect to the
# CNPG Postgres cluster running in the aap-cc namespace.
#
# IMPORTANT: Before applying, replace CHANGEME with the actual
# password from the CNPG superuser secret:
#
#   oc get secret aap-cc-pg-superuser -n aap-cc \
#     -o jsonpath='{.data.password}' | base64 -d
#
# Once you have the password, base64-encode it and replace the
# CHANGEME values below, or use SealedSecrets / SOPS to manage
# them safely in Git.
# -----------------------------------------------------------
apiVersion: v1
kind: Secret
metadata:
  name: aap-cc-gateway-postgres-configuration
  namespace: aap-cc
type: Opaque
stringData:
  host: aap-cc-pg-rw.aap-cc.svc
  port: "5432"
  database: aap_gateway
  username: app
  password: CHANGEME
  sslmode: prefer
  type: unmanaged
---
